// graph_walk.tasm — depth-limited pointer chase through linked nodes.
//
// Each node is laid out as:
//   offset 0:  data field (64 bit)
//   offset 8:  next pointer (64-bit unified address; offset within
//              same region for the simulator)
//
// Args (via dispatcher r1..r8):
//   r1 = start_node_addr     (unified address, device 0)
//   r2 = depth               (number of hops to chase; >= 1)
//
// Returns:
//   r1 = data field of the final node visited
//   r2 = address of the final node
//
// ANDI mask on the loaded next-pointer satisfies the verifier's
// "opaque-LOAD-as-address requires ANDI" rule (paper §3.3).  The
// region 0 (graph_pool) has size 0x80000000, so we mask to
// 0x7FFFFFF8 (8-byte aligned, fits in region).

  .arg cur    r1
  .arg depth  r2

  // Bounded loop: chase `depth` pointers.  Each iteration overwrites
  // r1 with the next-pointer at offset 8 of the current node, then
  // masks it into region 0's offset window.
  LOOP r2, walk_end          // body length 2
  LOAD r1, [r1 + 8]
  ANDI r1, r1, 0x7FFFFFF8

walk_end:
  // r1 now holds the address of the final node.
  ADDI r2, r1, 0             // r2 = r1 (address of final node)
  LOAD r1, [r1 + 0]          // r1 = final data
  RET  r1
